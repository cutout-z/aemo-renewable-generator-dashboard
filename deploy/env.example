APP_DIR=/workspace/repos/aemo-renewable-generator-dashboard
PIPELINE_ARGS=--full-refresh
RUN_TESTS=1
# Lane data checks (the offline pytest suite and the fixed ISP A3 reference, before the commit): 0 = warn-only (a
# failure turns the lane red, the data still publishes); 1 = a failure holds back the commit and push.
LANE_TESTS_BLOCK_PUSH=0
PUSH_CHANGES=1
COMMIT_MESSAGE_PREFIX=Update renewable generator dashboard data
