[Unit]
Description=AEMO Renewable Generator Dashboard monthly update
Documentation=https://github.com/cutout-z/aemo-renewable-generator-dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=aemo
Group=aemo
WorkingDirectory=/opt/aemo-renewable-generator-dashboard
EnvironmentFile=-/etc/aemo-renewable-generator-dashboard/env
ExecStart=/opt/aemo-renewable-generator-dashboard/deploy/run-vps-update.sh
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

StandardOutput=journal
StandardError=journal
