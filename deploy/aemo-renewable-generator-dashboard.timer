[Unit]
Description=Monitor AEMO Renewable Generator Dashboard source data
Documentation=https://github.com/cutout-z/aemo-renewable-generator-dashboard

[Timer]
# Check daily after upstream AEMO credit/MLF/reference lanes have had a chance to publish.
OnCalendar=*-*-* 01:10:00
RandomizedDelaySec=30m
Persistent=true
Unit=aemo-renewable-generator-dashboard.service

[Install]
WantedBy=timers.target
